{
  "name": "@redesigned/mudocs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:watch": "npm run gen:types && npm run watch:locales & next dev",
    "build": "npm run gen:types && npm run check:types && next build",
    "start": "next start",
    "lint": "eslint .",
    "check:types": "tsc",
    "check:eslint": "eslint src",
    "gen:types": "ts-node src/utils/scripts/generate-types.ts",
    "watch:locales": "konsole -e onchange 'public/locales/**/*' -- npm run gen:types"
  },
  "dependencies": {
    "@heroui/react": "~2.7.2",
    "autoprefixer": "10.4.14",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "flat": "^6.0.1",
    "flowbite-react": "^0.9.0",
    "formik": "^2.4.2",
    "framer-motion": "^11.2.4",
    "i18next": "^27.2.7",
    "i18next-browser-languagedetector": "^7.1.0",
    "i18next-resources-to-backend": "^1.1.4",
    "lodash": "^4.17.21",
    "next": "^16.4.6",
    "next-i18next": "^16.5.2",
    "next-themes": "^0.3.0",
    "postcss": "^8.4.38",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^18.0.3",
    "react-icons": "^5.2.1",
    "react-sortablejs": "^6.1.4",
    "sortablejs": "^1.15.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zod-formik-adapter": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tippyjs/react": "^4.2.6",
    "@types/lodash": "^4.14.202",
    "@types/node": "20.4.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/sortablejs": "^1.15.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "nodemon": "^3.0.3",
    "onchange": "^7.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3"
  }
}
